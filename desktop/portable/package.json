{
  "name": "zelotez-rooms-desktop",
  "version": "0.1.40",
  "description": "ZeloteZ Rooms desktop client",
  "author": "ZeloteZ",
  "desktopName": "de.zelotez.rooms.desktop",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "electron .",
    "build:win-audio": "node windows-audio/build.cjs",
    "build:win-video": "node windows-video/build.cjs",
    "prebuild:win": "npm run build:win-audio && npm run build:win-video",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:linux-video": "bash linux-video/build.sh",
    "prebuild:linux": "npm run build:linux-video",
    "build:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.8"
  },
  "build": {
    "appId": "de.zelotez.rooms",
    "productName": "ZeloteZ Rooms",
    "artifactName": "ZeloteZ-Rooms-${version}-${arch}.${ext}",
    "files": [
      "*.cjs",
      "ui/**"
    ],
    "asarUnpack": ["ui/icon.png"],
    "afterAllArtifactBuild": "build/appimage.cjs",
    "protocols": [{
      "name": "ZeloteZ Rooms share links",
      "schemes": ["zelotez-rooms"]
    }],
    "extraResources": [{
      "from": "../..",
      "to": "licenses/zelotez-rooms",
      "filter": ["LICENSE", "LICENSING.md"]
    }],
    "nsis": {
      "license": "../../LICENSE"
    },
    "win": {
      "target": "nsis",
      "icon": "ui/icon.png",
      "extraResources": [{
        "from": "windows-audio",
        "to": "windows-audio",
        "filter": ["rooms-windows-audio.exe"]
      }, {
        "from": "windows-video",
        "to": "windows-video",
        "filter": ["rooms-windows-capture.exe"]
      }]
    },
    "linux": {
      "target": "AppImage",
      "executableArgs": [],
      "icon": "ui/icon.png",
      "syncDesktopName": true,
      "category": "Network",
      "extraResources": [{
        "from": "..",
        "to": "native-capture",
        "filter": ["capture_helper.py", "streamer.py", "media.py", "model.py", "app_audio.py", "i18n.py", "capture.css"]
      }, {
        "from": "linux-video",
        "to": "native-capture",
        "filter": ["libgstroomscapture.so"]
      }]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
