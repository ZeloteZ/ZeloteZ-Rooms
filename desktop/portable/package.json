{
  "name": "zelotez-rooms-desktop",
  "version": "0.1.29",
  "description": "ZeloteZ Rooms desktop client",
  "author": "ZeloteZ",
  "desktopName": "de.zelotez.rooms.desktop",
  "private": true,
  "main": "main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.8"
  },
  "build": {
    "appId": "de.zelotez.rooms",
    "productName": "ZeloteZ Rooms",
    "artifactName": "ZeloteZ-Rooms-${version}-${arch}.${ext}",
    "files": [
      "*.cjs",
      "ui/**"
    ],
    "protocols": [{
      "name": "ZeloteZ Rooms share links",
      "schemes": ["zelotez-rooms"]
    }],
    "win": {
      "target": "nsis",
      "icon": "ui/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "executableArgs": [],
      "icon": "ui/icon.png",
      "syncDesktopName": true,
      "category": "Network",
      "extraResources": [{
        "from": "..",
        "to": "native-capture",
        "filter": ["capture_helper.py", "streamer.py", "media.py", "model.py", "app_audio.py", "i18n.py", "capture.css"]
      }]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
